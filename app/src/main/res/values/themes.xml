<resources>
    <!-- Base app theme -->

    <style name="Theme.SehattSathi" parent="Theme.Material3.DayNight">
        <!-- Completely remove the ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Optional: Transparent status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/bbb</item>
        <item name="postSplashScreenTheme">@style/Theme.SehattSathi</item>
    </style>



    <style name="Theme.MyTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar"></style>
</resources>
