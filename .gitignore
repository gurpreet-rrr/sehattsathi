*.jks
*.keystore
keystore.properties

# JVM crash & replay logs
hs_err_pid*.log
replay_pid*.log

# All logs
*.log

# Zipped project backups
*.zip

# OS / misc
.DS_Store
Thumbs.db
*.bak
*.tmp
